# ─────────────────────────────────────────────────────────────────────────────
# SiteGrade — Docker Local Dev Environment
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.docker.example .env.docker
# 2. Fill in the values marked <FILL_IN>
# 3. Run:            docker compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Supabase (cloud — external to Docker) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://hiufunxsgtnyutiuhljp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhpdWZ1bnhzZ3RueXV0aXVobGpwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUwNTkwNzEsImV4cCI6MjEwMDYzNTA3MX0.yimD-CL7Xrp-ruKjtoChWnrH1yF_Z0gT-STg0DoQjF8

# Server-side Supabase (API + Worker only — never expose to browser)
SUPABASE_URL=https://hiufunxsgtnyutiuhljp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhpdWZ1bnhzZ3RueXV0aXVobGpwIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTA1OTA3MSwiZXhwIjoyMTAwNjM1MDcxfQ.S8aEY2gHuwnYnEKDxate07mKYpNGCv4us65vqZVnSlc

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Direct connection (used by Prisma for migrations)
DATABASE_URL=postgresql://postgres:Webauditworkers@db.hiufunxsgtnyutiuhljp.supabase.co:5432/postgres
# Direct URL alias (Prisma requires this when using pgbouncer pooler)
DIRECT_URL=postgresql://postgres:Webauditworkers@db.hiufunxsgtnyutiuhljp.supabase.co:5432/postgres

# ── Redis (local Docker container — pre-configured, no changes needed) ────────
# Points to the redis service defined in docker-compose.yml
REDIS_URL=redis://redis:6379
# Set to "true" to use local ioredis instead of Upstash client
USE_LOCAL_REDIS=true

# Upstash Redis (optional — leave blank for local dev, Docker uses local Redis)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=<FILL_IN: run `openssl rand -base64 32`>

# ── OpenAI (optional — AI recommendations disabled if blank) ──────────────────
OPENAI_API_KEY=

# ── Stripe (optional — billing stubbed out, app runs without these) ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email / Resend (optional — emails disabled if blank) ──────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@sitegra.de

# ── Worker config ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
